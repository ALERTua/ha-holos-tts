# Settings of the server.
#
# How to use this file:
# 1. Copy it to a file with the name .env, next to docker-compose.yml.
# 2. To change a setting, remove the "#" at the start of its line and type your value.
# Each line shows the default value. A line that keeps its "#" uses the default.
#
# An on/off setting takes 1 (on) or 0 (off). It also takes true/false, yes/no and on/off.
# If a value is wrong, the server does not start, and its log tells you which setting is wrong.
# The README has the same list as a table.


# ---- Ports ----

# The port for Home Assistant integrations that use the OpenAI speech API.
# Change it if another program on your computer already uses port 8000.
# HTTP_PORT=8000

# The port for the Wyoming integration of Home Assistant.
# Change it if another program on your computer already uses port 10200.
# WYOMING_PORT=10200

# The network address that the server listens on. 0.0.0.0 means "all addresses".
# Keep it in Docker. Without Docker, 127.0.0.1 accepts only requests from the same computer.
# HTTP_HOST=0.0.0.0
# WYOMING_HOST=0.0.0.0


# ---- Voice and speed ----

# The voice for a request that does not choose a voice, or that names a voice the server does not know.
# Use a name from http://<server>:8000/v1/audio/voices.
# The Wyoming integration always uses this voice unless you choose another voice in Home Assistant.
# DEFAULT_VOICE=Speaker_67

# The speed of the speech, from 0.5 (slow) to 2.0 (fast). 1.0 is the normal speed.
# The Wyoming integration cannot send a speed, so it always uses this one.
# DEFAULT_SPEED=1.0

# 1: the server reads numbers, dates, units and abbreviations as words, for example "о 15:30" as "о пʼятнадцятій тридцять".
# 0: the server reads them as they are written. Then it does not download this extra model (1.9 GB) and uses about 0.5 GB less memory.
# Set 0 only if your texts have no digits or symbols.
# (AUTO_USE_VERBALIZER is the old name of this setting.)
# VERBALIZE=1


# ---- Web page ----

# 1: the server also shows a web page at http://<server>:8000/web/ where you type a text, choose a voice and listen to it.
# 0: the server has no web page. It then does not load the web page library.
# The page has no password. It uses the same port as the API, so only turn it on in a network that you trust.
# The page adds about 80 MB to the memory of the server.
# WEB_UI=0


# ---- Memory and speed ----

# Where the speech runs: cpu or cuda (an NVIDIA graphics card).
# Do not change it. Choose the image instead: "latest" for cpu, "latest-cuda" for cuda.
# DEVICE=cpu

# Where the number reader (VERBALIZE) runs: cpu or cuda. The default is the same as DEVICE.
# In the cuda image, set cpu if your graphics card does not have enough free memory.
# VERBALIZER_DEVICE=cpu

# 1: the server loads its models right after it starts, so the first request is fast.
# 0: the server loads the models at the first request. That request then takes several seconds more.
# PRELOAD=1

# After this many seconds without requests, the server frees the memory of its models.
# The server then uses about 0.44 GB instead of about 1.5 GB, and the next request takes about 3.5 s instead of about 1.3 s.
# 0 never frees the memory. Try 600 (10 minutes) if your server needs the memory for other programs.
# UNLOAD_AFTER_SECONDS=0

# After this many seconds without a text that has numbers or symbols, the server frees the memory of the number reader (about 0.5 GB).
# The next text with numbers then takes about 1 second more. 0 never frees it.
# Use a value below UNLOAD_AFTER_SECONDS.
# VERBALIZER_UNLOAD_AFTER_SECONDS=0


# ---- CPU ----

# How many CPU cores each model can use.
# 0 means: as many as the container may use. With a CPU limit, for example --cpus 4, the server uses 4 on most current Linux systems.
# With pinned cores, for example --cpuset-cpus=1-3 or CPU pinning in Unraid, the server uses 3. With both, it uses the smaller number.
# Set a smaller number if the server slows down other programs on the same computer.
# THREADS=0


# ---- Downloads and folders ----

# A Hugging Face access token. Set it only if Hugging Face stops the model download at the first start.
# A token with the "Read" role is enough. Docker shows this value to anyone who can run "docker inspect".
# To keep the token out of the settings, use a Docker secret instead: see "Hugging Face token" in the README.
# HF_TOKEN=

# The user and the group that the container runs as.
# Change them if your ./data folder belongs to another user. That user must be able to write into ./data.
# PUID=1000
# PGID=1000

# The folders inside the container. Do not change them. Put your folder at /data instead.
# DATA_DIR=/data
# HF_HOME=/data/huggingface
# STANZA_RESOURCES_DIR=/data/stanza


# ---- Other package versions (advanced) ----

# A file with package versions to install instead of the versions in the image.
# Use it only if your graphics card needs another build. See "Overriding packages" in the README.
# The first start with this file installs the packages into /data/venv and takes several minutes.
# UV_OVERRIDE=/data/user_requirements.txt

# An extra download address for the packages in the UV_OVERRIDE file.
# Set it if the section that you use in user_requirements.txt.example names one.
# UV_EXTRA_INDEX_URL=


# ---- Log ----

# How much the server writes into its log: DEBUG, INFO, WARNING, ERROR or CRITICAL. Another value stops the start.
# INFO writes the text of each request. Set WARNING to keep your texts out of the log.
# Set DEBUG to find out why a word sounds wrong.
# LOG_LEVEL=INFO
